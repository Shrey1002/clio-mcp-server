CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REGION=ca                 # us | ca | eu | au  (token from one region is rejected by the others)
CLIO_API_VERSION=4.0.13        # pin; never "latest" (invalid versions return 410)
CLIO_REDIRECT_PORT=5678
CLIO_REDIRECT_PATH=/callback   # use "none" if your Clio app's redirect URI is just http://127.0.0.1:PORT
CLIO_TOKEN_STORE_PATH=         # optional absolute path (default ~/.clio-mcp/tokens.json)
CLIO_TOKEN_ENCRYPTION_KEY=     # optional; any long secret -> AES-256-GCM encrypts the token file
CLIO_DISABLE_WRITE=true        # hide clio_create_* tools
CLIO_DISABLE_UPDATE=true       # hide clio_update_* / clio_set_* tools
CLIO_DISABLE_DELETE=true       # hide clio_delete_* tools
CLIO_REQUIRE_CONFIRM=true      # preview -> confirm on every non-read tool
CLIO_DEFAULT_ATTORNEY_ID=      # optional User ID fallback for matter creation / flat fee
CLIO_UNTRUSTED_TEXT_MODE=flag  # flag = keep cleaned text + warn | redact = withhold suspicious text
CLIO_INJECTION_POLICY=approve  # after suspicious text: approve = ask the human | block | warn
CLIO_AUDIT_LOG_PATH=           # optional JSONL audit log for every write
